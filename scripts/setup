#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Install common requirements (pip) first so any pip upgrade completes
# before the rest of the dependencies are installed.
python3 -m pip install --requirement requirements_common.txt
python3 -m pip install --requirement requirements_dev.txt
# The current pysainsburys release incorrectly declares Ruff as a runtime
# dependency at an unpublished version. Install it without dependencies until
# the upstream package metadata is corrected.
python3 -m pip install --no-deps pysainsburys==0.0.0
